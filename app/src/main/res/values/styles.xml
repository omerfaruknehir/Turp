<resources>
    <style name="Theme.Turp" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Turp.Launcher" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/turp_splash_fallback</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/turp_splash_fallback</item>
        <item name="android:navigationBarColor">@color/turp_splash_fallback</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.Turp.Launcher.Turp" parent="Theme.Turp.Launcher" />
    <style name="Theme.Turp.Launcher.Arbor" parent="Theme.Turp.Launcher">
        <item name="android:windowBackground">@color/turp_splash_arbor</item>
        <item name="android:statusBarColor">@color/turp_splash_arbor</item>
        <item name="android:navigationBarColor">@color/turp_splash_arbor</item>
    </style>
    <style name="Theme.Turp.Launcher.Graphite" parent="Theme.Turp.Launcher" />
    <style name="Theme.Turp.Launcher.Ocean" parent="Theme.Turp.Launcher" />
    <style name="Theme.Turp.Launcher.Violet" parent="Theme.Turp.Launcher" />
    <style name="Theme.Turp.Launcher.Sunset" parent="Theme.Turp.Launcher" />
    <style name="Theme.Turp.Launcher.System" parent="Theme.Turp.Launcher">
        <item name="android:windowBackground">@color/turp_splash_system</item>
        <item name="android:statusBarColor">@color/turp_splash_system</item>
        <item name="android:navigationBarColor">@color/turp_splash_system</item>
    </style>

</resources>
